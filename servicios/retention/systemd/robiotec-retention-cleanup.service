[Unit]
Description=Robiotec retention cleanup for DB, local files and MinIO

[Service]
Type=oneshot
WorkingDirectory=/root/robiotec
ExecStartPre=/usr/bin/mkdir -p /root/robiotec/servicios/retention/logs
ExecStart=/root/robiotec/servicios/retention/scripts/run.sh
Environment=ROBIOTEC_TELEMETRY_RETENTION_DAYS=180
Environment=ROBIOTEC_EVENT_RETENTION_DAYS=365
Environment=ROBIOTEC_FILE_RETENTION_DAYS=365
Environment=ROBIOTEC_MINIO_RETENTION_DAYS=365
Environment=ROBIOTEC_TOKEN_RETENTION_DAYS=30
Environment=ROBIOTEC_RETENTION_BATCH_SIZE=10000
Environment=ROBIOTEC_MINIO_RETENTION_ENABLED=true
Environment=ROBIOTEC_MINIO_ALIAS=local
StandardOutput=append:/root/robiotec/servicios/retention/logs/retention-cleanup.log
StandardError=append:/root/robiotec/servicios/retention/logs/retention-cleanup.log
