DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.0.1,robio-ai.com,www.robio-ai.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://robio-ai.com,https://www.robio-ai.com,http://10.0.0.1

DATABASE_URL=postgresql://robiotec_app:change_me@127.0.0.1:5432/robiotec_vms

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_WEBRTC_BASE_URL=/mediamtx
ROBIOTEC_SERVICE_TOKEN=
ROBIOTEC_FIELD_ENCRYPTION_KEY=
ROBIOTEC_PUBLIC_HOST=robio-ai.com
MEDIAMTX_RTSP_PORT=8554
ROBIOTEC_NOTIFICATION_SETTINGS_PATH=/root/robiotec/plataforma/data/notification_settings.json
ROBIOTEC_MEDIA_PROXY_TIMEOUT_SECONDS=20
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MATCH_CONFIDENCE_MIN=0.55
OSRM_REQUEST_TIMEOUT_SECONDS=0.8
OSRM_MAX_SEGMENTS_PER_REQUEST=8
OSRM_REQUEST_BUDGET_SECONDS=6.0
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
